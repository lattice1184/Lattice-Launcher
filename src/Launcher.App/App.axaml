<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Launcher.App.App"
             xmlns:local="using:Launcher.App"
             xmlns:behaviors="using:Launcher.App.Animations"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>

        <!-- ========== 设计令牌（单一调色板，视图引用资源而非硬编码） ========== -->
        <!-- 表面层 -->
        <Color x:Key="BgBase">#14181F</Color>
        <Color x:Key="BgSurface">#1D222C</Color>
        <Color x:Key="BgRaised">#242A36</Color>
        <Color x:Key="BgHover">#2C3544</Color>
        <Color x:Key="BgActive">#2A3240</Color>
        <Color x:Key="BorderColor">#2F3745</Color>
        <!-- 文本层 -->
        <Color x:Key="TextPrimary">#E8EAF0</Color>
        <Color x:Key="TextSecondary">#8A93A6</Color>
        <Color x:Key="TextDim">#6F7B90</Color>
        <Color x:Key="TextLog">#B8C2D4</Color>
        <!-- 强调（青绿，唯一饱和色）与状态 -->
        <Color x:Key="Accent">#2DD4BF</Color>
        <Color x:Key="AccentHover">#45E3CF</Color>
        <Color x:Key="OnAccent">#0B1F1C</Color>
        <Color x:Key="Danger">#E05A5A</Color>
        <Color x:Key="Success">#5AD07C</Color>
        <!-- 圆角与间距基准（圆滑不锐利） -->
        <CornerRadius x:Key="RadiusSmall">5</CornerRadius>
        <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
        <CornerRadius x:Key="RadiusLarge">10</CornerRadius>
        <!-- 间距基准（紧凑统一） -->
        <x:Double x:Key="SpaceXXS">4</x:Double>
        <x:Double x:Key="SpaceXS">6</x:Double>
        <x:Double x:Key="SpaceS">8</x:Double>
        <x:Double x:Key="SpaceM">10</x:Double>
        <x:Double x:Key="SpaceL">12</x:Double>
        <x:Double x:Key="SpaceXL">16</x:Double>
        <Thickness x:Key="PagePadding">12</Thickness>
        <Thickness x:Key="CardPad">12</Thickness>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- 全局字体：系统中文 UI 字体（弃 AI 默认 Inter） -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI Variable, Segoe UI"/>
        </Style>

        <!-- 按钮：弹性缩放由 SpringScaleBehavior 托管；涟漪由 RippleBehavior 托管（模板内置 RippleHost）。
             hover 变色由 HoverBrushBehavior 托管（本地值驱动——样式伪类 Setter 对模板绑定的驱动在 Avalonia 12 不可靠，AD1 根治） -->
        <Style Selector="Button">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="behaviors:SpringScaleBehavior.Enabled" Value="True"/>
            <Setter Property="behaviors:RippleBehavior.Enabled" Value="True"/>
            <Setter Property="behaviors:HoverBrushBehavior.Enabled" Value="True"/>
            <Setter Property="behaviors:HoverBrushBehavior.HoverBrush" Value="{StaticResource BgHover}"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="True">
                        <Grid>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                            <Canvas x:Name="RippleHost" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button:pressed">
            <!-- 按下变深（#1A2029 比所有按钮底暗；BgActive 反而比底亮会显"白影"） -->
            <Setter Property="Background" Value="#1A2029"/>
        </Style>

        <!-- 窗口与文本 -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource BgBase}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBlock.sub">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 按钮 -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource BgRaised}"/>
            <Setter Property="Foreground" Value="#C9D2E3"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- 主操作按钮（唯一饱和面；hover 亮青绿由行为驱动） -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="behaviors:HoverBrushBehavior.HoverBrush" Value="{StaticResource AccentHover}"/>
        </Style>

        <!-- 危险按钮（红字；hover 红底浅红字由行为驱动） -->
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="behaviors:HoverBrushBehavior.HoverBrush" Value="#22E05A5A"/>
            <Setter Property="behaviors:HoverBrushBehavior.HoverForeground" Value="{StaticResource Danger}"/>
        </Style>

        <!-- 幽灵按钮（hover 灰底白字由行为驱动） -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="behaviors:HoverBrushBehavior.HoverBrush" Value="{StaticResource BgRaised}"/>
            <Setter Property="behaviors:HoverBrushBehavior.HoverForeground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <!-- 生态 Tab（hover 默认 BgHover 由全局行为驱动） -->
        <Style Selector="Button.tab">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Background" Value="{StaticResource BgRaised}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        </Style>
        <Style Selector="Button.tab.active">
            <Setter Property="Background" Value="#12332F"/>
            <Setter Property="Foreground" Value="#B5F4E9"/>
        </Style>

        <!-- 输入控件 -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource BgRaised}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgRaised}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 玻璃卡片（液态玻璃点缀；日志/控制台保持实色 card 保证对比度） -->
        <Style Selector="Border.glass-card">
            <Setter Property="Background" Value="#E6242A36"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="BorderBrush" Value="#4D2F3745"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 卡片（圆角收敛；用于离散信息单元，不用于列表行） -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource BgRaised}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 列表行：扁平 + hover 背景过渡 + 分隔线（缩放会跳动，不做） -->
        <Style Selector="Border.row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.row:hover">
            <Setter Property="Background" Value="{StaticResource BgRaised}"/>
        </Style>

        <!-- 下载角标：下载中呼吸脉冲（高亮标记下载导航项） -->
        <Style Selector="Border.badge">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.55"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 阶段指示点：当前激活呼吸脉冲（仅 Opacity） -->
        <Style Selector="Border.stagedot.current">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.55"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 进度条（值变化平滑过渡） -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="{StaticResource BorderColor}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Value" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- 淡入工具类（Opacity 由绑定驱动时平滑过渡） -->
        <Style Selector="Control.anim-fade">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
