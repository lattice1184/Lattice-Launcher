<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             x:Class="Launcher.App.Views.SectionModulesView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="12">
    <!-- 存储 -->
    <Border Classes="setting-group">
        <StackPanel Spacing="10">
            <TextBlock Text="存储占用" Classes="group-header"/>
            <TextBlock Text="各数据占了多少磁盘空间：游戏版本、下载缓存、日志等。看不顺眼的项点删除就回收空间（删除前会再确认，删掉的重新下载即可）。"
                       Classes="dim" FontSize="11" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="重新扫描" Classes="ghost" FontSize="12" Padding="12,5"
                        Command="{Binding Storage.ReloadStatsCommand}"/>
                <Border Classes="help-hint"
                           ToolTip.Tip="每个分组的上限，单位是 MB。0 是不限。超了标红字。"
                           VerticalAlignment="Center"><Path/></Border>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Storage.StorageGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StorageGroupVM">
                        <Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                            <TextBlock Text="{Binding Name}" Classes="setting-label" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="dim" FontSize="11"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="超限" Classes="status-error" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding IsOverLimit}"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBox Width="56" FontSize="12" Padding="6,3"
                                         Text="{Binding CapText}"/>
                                <TextBlock Text="MB" Classes="dim" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="4" Content="清理" Classes="ghost" FontSize="12" Padding="10,4"
                                    Command="{Binding CleanCommand}" IsVisible="{Binding CanDelete}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>

    <!-- 内存优化（8-19 第二批：PCL 式但低写盘） -->
    <Border Classes="setting-group">
        <StackPanel Spacing="10">
            <TextBlock Text="内存优化" Classes="group-header"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="当前占用 {Binding CurrentMemoryText}" Classes="setting-label" VerticalAlignment="Center"/>
                <Button Content="立即释放内存" Classes="primary" FontSize="12" Padding="12,5" Cursor="Hand"
                        Command="{Binding TrimMemoryNowCommand}"/>
                <Border Classes="help-hint"
                           ToolTip.Tip="点一下立即压缩并释放内存（不写磁盘；「工作集修剪」开着时会额外写入页面文件）。释放量受当前后台任务影响"
                           VerticalAlignment="Center"><Path/></Border>
            </StackPanel>
            <TextBlock Text="自动模式：闲置或切出去时在后台压缩内存——轻度模式只压缩不写盘，对硬盘零影响；工作集修剪才是 PCL 那种把内存写进页面文件的方案，会增加硬盘读写，默认关。"
                       Classes="dim" FontSize="11" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="闲置时优化内存" Classes="setting-label" VerticalAlignment="Center"/>
                <ToggleSwitch IsChecked="{Binding MemoryOptimizeEnabled}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="工作集修剪（写页面文件）" Classes="setting-label" VerticalAlignment="Center"/>
                <ToggleSwitch IsChecked="{Binding MemoryTrimEnabled}"/>
                <Border Classes="help-hint"
                           ToolTip.Tip="把内存页写入页面文件换回物理内存——占用数字降得更狠，但会持续产生硬盘读写。固态盘寿命敏感就保持关闭"
                           VerticalAlignment="Center"><Path/></Border>
            </StackPanel>
            <Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="闲置多久触发（分钟）" Classes="setting-label" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"/>
                <TextBox Grid.Column="2" Width="56" FontSize="12" Padding="6,3"
                         Text="{Binding MemoryIdleMinutesText}" IsEnabled="{Binding MemoryOptimizeEnabled}"/>
            </Grid>
        </StackPanel>
    </Border>

    </StackPanel>
</UserControl>
