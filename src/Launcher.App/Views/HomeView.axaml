<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:svc="using:Launcher.App.Services"
             x:Class="Launcher.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="10">

        <!-- ① 启动控制卡（顶部一行高密度操作 + 阶段条） -->
        <Border Classes="card" Padding="12">
            <StackPanel Spacing="8">
                <!-- 行1：头像（点击弹账号面板）+ 版本 + 启动/停止 + 状态（一行） -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                    <Button x:Name="AvatarButton" Padding="0" Background="Transparent" BorderThickness="0"
                            Click="OnAvatarClick" ToolTip.Tip="账号管理（登录/切换/皮肤）">
                        <Border Width="44" Height="44" CornerRadius="10" ClipToBounds="True" Background="{StaticResource BgRaised}">
                            <Image Source="{Binding PlayerAvatar}" Width="44" Height="44" Stretch="Uniform"/>
                        </Border>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding PlayerName}" FontSize="15" FontWeight="SemiBold"/>
                            <Border CornerRadius="3" Padding="6,1" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                    VerticalAlignment="Center" IsVisible="{Binding Account.IsLoggedIn}">
                                <TextBlock Text="{Binding AccountTypeText}" FontSize="9" Foreground="{StaticResource Accent}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="YanKa Launcher" FontSize="11" Classes="dim"/>
                    </StackPanel>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding SelectedVersion}"
                              PlaceholderText="选择版本" MinWidth="160" MaxWidth="240" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VersionInstanceVM">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="3" Content="启动游戏" Classes="primary" Padding="26,9" FontSize="13"
                            Command="{Binding LaunchCommand}" VerticalAlignment="Center"
                            IsVisible="{Binding !IsRunning}"/>
                    <Button Grid.Column="3" Content="停止" Padding="26,9" FontSize="13"
                            Command="{Binding StopGameCommand}" VerticalAlignment="Center"
                            IsVisible="{Binding IsRunning}"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MinWidth="84">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding StateColor}"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LaunchState}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Grid>

                <!-- 行2：阶段指示条 + 状态文字（仅启动时显示，平时保持卡矮小） -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,8,0,0"
                      IsVisible="{Binding IsLaunching}">
                    <ItemsControl ItemsSource="{Binding Stages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LaunchStageVM">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Classes.stagedot="True" Classes.current="{Binding IsCurrent}"
                                            Width="8" Height="8" CornerRadius="4"
                                            Background="{Binding DotColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Column="1" Text="{Binding LaunchStatus}" Classes="sub" FontSize="11"
                               VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- 行3：配置摘要 -->
                <TextBlock Text="{Binding LaunchConfigText}" Classes="dim" FontSize="10"/>

                <!-- 启动失败修复入口（客户端文件缺失时显示） -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowRepairGuide}">
                    <TextBlock Text="{Binding RepairGuideText}" Foreground="{StaticResource Danger}" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="去版本页补全" Classes="primary" FontSize="11" Padding="14,5"
                                Command="{Binding GoRepairCommand}"/>
                        <Button Content="打开官方下载页" Classes="ghost" FontSize="11" Padding="14,5"
                                Command="{Binding OpenOfficialDownloadCommand}"/>
                    </StackPanel>
                </StackPanel>
                <!-- 进度条（卡内底部） -->
                <ProgressBar Value="{Binding LaunchProgress}" Maximum="100" Height="4"
                             IsVisible="{Binding IsLaunching}"/>
            </StackPanel>
        </Border>

        <!-- ② 日志卡（全宽；Tab 双视图：控制台 / 启动记录） -->
        <Border Classes="card" Grid.Row="1" Padding="0">
            <DockPanel>
                <!-- 头部 Tab -->
                <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}" Padding="12,8"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                    <Button Content="控制台" Classes="tab" Classes.active="{Binding IsConsoleTabSelected}"
                            FontSize="12" Padding="12,5" Command="{Binding SwitchLogTabCommand}" CommandParameter="console"/>
                    <Button Grid.Column="1" Classes="tab" Classes.active="{Binding IsHistoryTabSelected}"
                            FontSize="12" Padding="12,5" Command="{Binding SwitchLogTabCommand}" CommandParameter="history">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="启动记录"/>
                            <Border BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="8" Padding="5,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding HistoryCount}" Foreground="{StaticResource Accent}" FontSize="10"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Content="导出日志" Classes="ghost" FontSize="11" Padding="10,3"
                            Click="OnExportLogs" IsVisible="{Binding IsConsoleTabSelected}"/>
                    <Button Grid.Column="3" Content="清除记录" Classes="danger" FontSize="11" Padding="10,3"
                            Command="{Binding ClearLaunchHistoryCommand}" IsVisible="{Binding IsHistoryTabSelected}"/>
                </Grid>
                </Border>

                <!-- 主体：同格叠放两面板（可见者后声明收点击） -->
                <Grid>
                    <!-- 启动记录面板 -->
                    <ScrollViewer IsVisible="{Binding IsHistoryTabSelected}">
                        <StackPanel Spacing="4" Margin="12,10">
                            <TextBlock Text="暂无启动记录" Classes="dim" FontSize="12" HorizontalAlignment="Center"
                                       Margin="0,40,0,0" IsVisible="{Binding !HasHistory}"/>
                            <ItemsControl ItemsSource="{Binding LaunchHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="svc:LaunchHistoryEntry">
                                        <Grid ColumnDefinitions="Auto,88,*,Auto" ColumnSpacing="8" Margin="0,2" MinHeight="22">
                                            <TextBlock Text="{Binding TimeText}" Classes="dim" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding VersionId}" FontSize="11" LineHeight="16"
                                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Error}" FontSize="11"
                                                       Foreground="{StaticResource Danger}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="3" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                                    Background="#1E3A2E">
                                                <TextBlock Text="{Binding OutcomeText}" FontSize="10" Foreground="#5AD07C"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 控制台面板（后声明=选中时在最上层） -->
                    <Grid IsVisible="{Binding IsConsoleTabSelected}">
                        <ScrollViewer x:Name="LogScroll">
                            <ItemsControl ItemsSource="{Binding GameLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="#B8C2D4" TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <!-- 空状态 -->
                        <StackPanel IsVisible="{Binding !HasLogs}" Spacing="6" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="控制台空闲" Classes="sub" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="选择版本并点击「启动游戏」，日志将实时显示在这里" Classes="dim" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ③ 账号面板（头像点击弹出：当前账号 / 已保存列表 / 登录） -->
        <Popup x:Name="AccountPopup" Placement="Bottom" PlacementTarget="{Binding #AvatarButton}"
               IsLightDismissEnabled="True"
               Opened="OnAccountPopupOpened">
            <Border x:Name="AccountPanel" Classes="card" Padding="12" Width="320">
                <StackPanel Spacing="10">
                    <!-- 当前账号行 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Width="40" Height="40" CornerRadius="8" ClipToBounds="True" Background="{StaticResource BgRaised}">
                            <Image Source="{Binding Account.Avatar}" Width="40" Height="40" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Account.CurrentName}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Account.AccountType}" Classes="dim" FontSize="11"
                                       IsVisible="{Binding Account.IsLoggedIn}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="退出" Classes="ghost" FontSize="11" Padding="10,4"
                                VerticalAlignment="Center" Command="{Binding Account.LogoutCommand}"
                                IsVisible="{Binding Account.IsLoggedIn}"/>
                    </Grid>

                    <!-- 已保存账号列表（切换/删除） -->
                    <Border CornerRadius="6" Background="{StaticResource BgBase}" Padding="8"
                            IsVisible="{Binding Account.Accounts.Count}">
                        <ItemsControl ItemsSource="{Binding Account.Accounts}" MaxHeight="160">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccountRowVM">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                                            <Border CornerRadius="3" Padding="5,1" Background="#12332F"
                                                    VerticalAlignment="Center" IsVisible="{Binding IsCurrent}">
                                                <TextBlock Text="当前" FontSize="9" Foreground="#B5F4E9"/>
                                            </Border>
                                            <TextBlock Text="{Binding TypeText}" Classes="dim" FontSize="10"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="切换" Classes="ghost" FontSize="10" Padding="8,2"
                                                Click="OnSwitchAccount" CommandParameter="{Binding}"
                                                IsVisible="{Binding !IsCurrent}"/>
                                        <Button Grid.Column="2" Content="删除" Classes="danger" FontSize="10" Padding="8,2"
                                                Click="OnDeleteAccount" CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- 登录表单 -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding Account.NameInput}" Watermark="用户名（离线登录）" FontSize="12"/>
                        <Button Grid.Column="1" Content="离线登录" Classes="primary" FontSize="11" Padding="12,6"
                                Command="{Binding Account.LoginOfflineCommand}"/>
                        <Button Grid.Column="2" Content="正版登录" FontSize="11" Padding="12,6"
                                Command="{Binding Account.LoginMicrosoftCommand}"
                                IsEnabled="{Binding !Account.IsMsAuthBusy}"/>
                    </Grid>
                    <Button Content="更换皮肤…" Classes="ghost" FontSize="11" Padding="8,3"
                            HorizontalAlignment="Left" Click="OnPickSkin"/>

                    <!-- 正版授权进度 / 操作状态 -->
                    <Border CornerRadius="6" Padding="8,6" Background="#12332F" IsVisible="{Binding Account.IsMsAuthBusy}">
                        <TextBlock Text="{Binding Account.MsAuthStatus}" FontSize="11" Foreground="#B5F4E9"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="{Binding Account.Status}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
