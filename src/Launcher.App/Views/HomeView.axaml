<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:svc="using:Launcher.App.Services"
             x:Class="Launcher.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid ColumnDefinitions="340,1" ColumnSpacing="14">
        <!-- 左：启动控制（PCL 式集中左侧） -->
        <StackPanel Grid.Column="0" Spacing="10">
            <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left"
                    Click="OnAvatarClick" ToolTip.Tip="点击更换皮肤">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="56" Height="56" CornerRadius="8" ClipToBounds="True" Background="{StaticResource BgRaised}">
                        <Image Source="{Binding PlayerAvatar}" Width="56" Height="56" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlayerName}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="YanKa Launcher" FontSize="12" Classes="dim"/>
                        <TextBlock Text="点击头像换皮肤" FontSize="10" Classes="dim"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- 启动阶段指示条（颜色只在圆点上，文字统一灰阶） -->
            <ItemsControl ItemsSource="{Binding Stages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LaunchStageVM">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="8" Height="8" CornerRadius="4"
                                    Background="{Binding DotColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding LaunchStatus}" Classes="sub"/>
            <TextBlock Text="{Binding LaunchConfigText}" Classes="dim" FontSize="11"/>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <ComboBox ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding SelectedVersion}"
                          PlaceholderText="选择版本">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VersionInstanceVM">
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Content="启动游戏" Classes="primary" Padding="32,10" FontSize="14"
                        Command="{Binding LaunchCommand}"
                        IsVisible="{Binding !IsRunning}"/>
                <Button Grid.Column="1" Content="停止" Padding="32,10" FontSize="14"
                        Command="{Binding StopGameCommand}"
                        IsVisible="{Binding IsRunning}"/>
                <!-- 状态圆点 + 文字（替代 50% 透明度的禁用按钮） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MinWidth="90">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding StateColor}"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LaunchState}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </Grid>

            <ProgressBar Value="{Binding LaunchProgress}" Maximum="100" Height="5"
                         IsVisible="{Binding IsLaunching}"/>
        </StackPanel>

        <!-- 右：游戏控制台（弹性大区）+ 启动记录 -->
        <DockPanel Grid.Column="1">
            <Border Classes="card" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="游戏控制台" Classes="sub" FontSize="12" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="导出日志" Classes="ghost" FontSize="11" Padding="10,3"
                                Click="OnExportLogs"/>
                    </Grid>
                    <ScrollViewer x:Name="LogScroll">
                        <ItemsControl ItemsSource="{Binding GameLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                               Foreground="#B8C2D4" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        <!-- 启动记录（跨会话，可回看失败原因） -->
            <Expander DockPanel.Dock="Bottom" Header="启动记录" IsExpanded="False" Margin="0,10,0,0">
                <StackPanel Spacing="6" Margin="0,6,0,0">
                <Button Content="清除记录" Classes="danger" Padding="8,3" FontSize="11"
                        HorizontalAlignment="Left" Command="{Binding ClearLaunchHistoryCommand}"/>
                <ItemsControl ItemsSource="{Binding LaunchHistory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:LaunchHistoryEntry">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Margin="0,2">
                                <TextBlock Text="{Binding TimeText}" Classes="dim" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="{Binding VersionId}" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding Error}" FontSize="11"
                                           Foreground="{StaticResource Danger}" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="3" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                        Background="#1E3A2E">
                                    <TextBlock Text="{Binding OutcomeText}" FontSize="10" Foreground="#5AD07C"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Expander>
        </DockPanel>
    </Grid>
</UserControl>
