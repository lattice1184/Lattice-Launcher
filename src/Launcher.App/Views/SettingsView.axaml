<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             x:Class="Launcher.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
            <TextBlock Text="设置" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="游戏目录 / 启动参数 / 下载选项（改动即时生效）" Classes="sub" FontSize="12"/>
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="10" MaxWidth="720" HorizontalAlignment="Left">

                <!-- 游戏目录 -->
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="游戏目录" FontSize="14" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Grid.Column="0" Text="{Binding GameDirectoryText}" IsReadOnly="True"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="浏览…" Classes="ghost" Click="OnBrowseGameDir"/>
                                <Button Content="默认" Classes="ghost" Click="OnResetGameDir"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding SourceLabelText}" Classes="dim" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="版本隔离（各版本独立存档/模组，不串门）" Classes="sub" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <ToggleSwitch IsChecked="{Binding VersionIsolation}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 启动 -->
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="启动" FontSize="14" FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="内存分配" Classes="sub" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MemoryPresets}"
                                      SelectedItem="{Binding SelectedMemoryPreset}" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MemoryPresetVM">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding IsCustomMemory}">
                                <TextBox Width="90" Text="{Binding MemoryCustomText}"
                                         KeyDown="OnMemoryCustomKeyDown" LostFocus="OnMemoryCustomLostFocus"/>
                                <TextBlock Text="MB" Classes="dim" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="Java 路径" Classes="sub" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding JavaPathText}" Watermark="自动选配（PCL 运行库 / PATH）"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="浏览…" Classes="ghost" Click="OnBrowseJava"/>
                                <Button Content="自动" Classes="ghost" Click="OnResetJava"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="额外 JVM 参数" Classes="sub" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding ExtraJvmArgsText}"
                                     Watermark="-Dxxx=1 -Xss2m（空格分隔）"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="启动时自动写入中文语言" Classes="sub" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleSwitch IsChecked="{Binding AutoChineseEnabled}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 下载 -->
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="下载" FontSize="14" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="官方源失败时回退镜像（BMCLAPI）" Classes="sub" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleSwitch IsChecked="{Binding MirrorFallbackEnabled}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="最大并发下载数" Classes="sub" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="1" Maximum="16" TickFrequency="1" Value="{Binding MaxConcurrentDownloads}"/>
                            <TextBlock Grid.Column="2" Text="{Binding MaxConcurrentDownloads}" Classes="dim" FontSize="12"
                                       Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="下载限速（KB/s，0=不限）" Classes="sub" FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="20000" TickFrequency="100" Value="{Binding SpeedLimitKbps}"/>
                            <TextBlock Grid.Column="2" Text="{Binding SpeedLimitKbps}" Classes="dim" FontSize="12"
                                       Width="56" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
