<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Launcher.App.Views.GameDirSetupWindow"
        Title="选择游戏目录"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurface}">

    <StackPanel x:Name="Root" Margin="28,24" Spacing="14">
        <TextBlock Text="欢迎使用 Starview" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="你的游戏版本、模组、存档都放这个文件夹。选空间充足的磁盘。以后在设置里还能改。"
                   Classes="sub" FontSize="13" TextWrapping="Wrap"/>

        <TextBox x:Name="PathBox" FontSize="13"/>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="浏览…" Classes="ghost" Padding="14,7" Click="OnBrowse"/>
            <Button Content="使用默认目录" Classes="ghost" Padding="14,7" Click="OnReset"/>
            <Button Content="开始使用" Classes="primary" Padding="20,7" Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</Window>
