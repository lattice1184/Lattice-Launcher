<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Launcher.App.Views.GameDirSetupWindow"
        Title="选择游戏目录"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgSurface}">

    <StackPanel Margin="28,24" Spacing="14">
        <TextBlock Text="欢迎使用 YanKa Launcher" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="游戏版本、模组、存档将存放在下面的文件夹。建议放在剩余空间充足的盘（如 D 盘）；以后也可手动修改。"
                   Classes="sub" FontSize="13" TextWrapping="Wrap"/>

        <TextBox x:Name="PathBox" FontSize="13" Padding="10,7"/>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="浏览…" Classes="ghost" Padding="14,7" Click="OnBrowse"/>
            <Button Content="使用默认目录" Classes="ghost" Padding="14,7" Click="OnReset"/>
            <Button Content="开始使用" Classes="primary" Padding="20,7" Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</Window>
