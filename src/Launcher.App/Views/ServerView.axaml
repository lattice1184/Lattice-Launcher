<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             x:Class="Launcher.App.Views.ServerView"
             x:DataType="vm:ServerViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
            <TextBlock Text="开服" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="下载服务端 → 配置 → 启动，控制台实时查看" Classes="sub" FontSize="12"/>
        </StackPanel>

        <Grid ColumnDefinitions="2*,1,3*">
        <ScrollViewer Grid.Column="0" MinWidth="240">
            <StackPanel Spacing="8">

                <!-- 版本选择 + 操作 -->
                <Border Classes="card" Padding="12">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding InstalledVersions}"
                                      SelectedItem="{Binding SelectedVersion}"
                                      PlaceholderText="选择已安装版本">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VersionInstanceVM">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="刷新" Classes="ghost" Padding="12,8"
                                    Command="{Binding RefreshVersionsCommand}"/>
                            <Button Grid.Column="2" Content="下载服务端" Classes="primary" Padding="16,8"
                                    Command="{Binding DownloadServerCommand}" IsEnabled="{Binding !IsInstalling}"/>
                            <Button Grid.Column="3" Content="启动" Classes="primary" Padding="24,8"
                                    Command="{Binding StartServerCommand}" IsVisible="{Binding !IsRunning}"/>
                            <Button Grid.Column="3" Content="停止" Padding="24,8"
                                    Command="{Binding StopServerCommand}" IsVisible="{Binding IsRunning}"/>
                        </Grid>
                        <TextBlock Text="{Binding Status}" Classes="sub" FontSize="12"/>
                        <TextBlock Text="{Binding ServerDirText}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 机器状态 + 建议配置 -->
                <Border Classes="card" Padding="12">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Text="机器状态" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="应用建议" Classes="primary" Padding="14,5"
                                    Command="{Binding ApplySuggestionCommand}"/>
                            <Button Grid.Column="2" Content="刷新状态" Classes="ghost" Padding="14,5"
                                    Command="{Binding RefreshMachineStatusCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding MachineStatusText}" Classes="sub" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <!-- server.properties 图形化 -->
                <Border Classes="card" Padding="12">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="server.properties" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="保存配置" Classes="ghost" Padding="14,5"
                                    Command="{Binding SavePropertiesCommand}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PropRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PropRowVM">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,3">
                                        <TextBlock Text="{Binding Label}" Classes="sub" FontSize="12" MinWidth="110"
                                                   VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding BoolValue}"
                                                      IsVisible="{Binding IsBool}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding Value}" FontSize="12"
                                                  IsVisible="{Binding IsChoice}"/>
                                        <TextBox Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                                 IsVisible="{Binding IsText}"/>
                                        <TextBox Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                                 IsVisible="{Binding IsNumber}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>


                <!-- 拖拽分隔条（用户可调左右比例） -->
                <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                              Background="{StaticResource BorderColor}" ResizeDirection="Columns"/>

                <!-- 右：控制台（占满） -->
                <Border Grid.Column="2" Classes="card" Padding="0" MinWidth="300">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12,8"
                                Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="控制台" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="导出日志" Classes="ghost" FontSize="11" Padding="10,3"
                                        Click="OnExportLogs"/>
                            </Grid>
                        </Border>
                        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="12,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" x:Name="CommandBox" Watermark="输入命令（如 say hello / list / op Steve）"
                                         KeyDown="OnCommandKeyDown"/>
                                <Button Grid.Column="1" Content="发送" Classes="ghost" Padding="16,6"
                                        Click="OnSendClick" IsEnabled="{Binding IsRunning}"/>
                            </Grid>
                        </StackPanel>
                        <Grid>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Logs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                                       Foreground="{StaticResource TextLog}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="启动服务端后日志显示在此" Foreground="{StaticResource TextDim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding Logs.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
