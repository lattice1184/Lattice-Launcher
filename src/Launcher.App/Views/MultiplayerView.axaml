<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             x:Class="Launcher.App.Views.MultiplayerView"
             x:DataType="vm:MultiplayerViewModel">

    <DockPanel>
        <!-- 顶部：标题 + 说明 -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="联机" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="房主在游戏里开局域网世界，朋友输入房间码即可加入。联机方案：陶瓦（自动代理）或 EasyTier（虚拟组网）。"
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ModuleVersionText}" Classes="dim" FontSize="11" VerticalAlignment="Bottom"/>
            </StackPanel>
        </StackPanel>

        <!-- 未同意协议提示条（琥珀警告：联机页约定色） -->
        <Border x:Name="DeclinedBanner" DockPanel.Dock="Top" Background="{DynamicResource WarnBg}" CornerRadius="6" Padding="10,6"
                Margin="0,0,0,8" IsVisible="{Binding IsDeclined}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Foreground="{DynamicResource WarnText}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center">
                    你还没同意联机功能协议。联机暂时用不了，同意后就能创建或加入房间。
                </TextBlock>
                <Button Grid.Column="1" Content="阅读并同意" Classes="primary" FontSize="11" Padding="12,4"
                        Command="{Binding ReopenAgreementCommand}"/>
            </Grid>
        </Border>

        <!-- 错误提示条（项目约定错误红）：原因 + 建议 + 可修复时「一键修复」按钮 -->
        <Border DockPanel.Dock="Top" Background="#3A2020" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                IsVisible="{Binding HasError}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Foreground="#E05A5A" FontSize="12" TextWrapping="Wrap" Text="{Binding ErrorText}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="修复" Classes="primary" FontSize="11" Padding="12,4"
                        IsVisible="{Binding HasFixableError}" IsEnabled="{Binding !IsRepairing}"
                        Command="{Binding RepairNowCommand}"/>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Spacing="12">
                <!-- 主界面：tab 切换（创建 / 加入） -->
                <StackPanel x:Name="WelcomeBlock" IsVisible="{Binding IsWelcome}" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="tab" Classes.active="{Binding IsCreateTab}" Content="创建房间"
                                Command="{Binding SwitchTabCommand}" CommandParameter="create"/>
                        <Button Classes="tab" Classes.active="{Binding IsJoinTab}" Content="加入房间"
                                Command="{Binding SwitchTabCommand}" CommandParameter="join"/>
                    </StackPanel>

                    <!-- 联机方案选择（8-14 第二联机：陶瓦/EasyTier） -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="联机方案" Classes="sub" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding BackendOptions}" SelectedItem="{Binding SelectedBackend}"
                                  MinWidth="260">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MultiplayerViewModel+MultiplayerBackendOption">
                                    <TextBlock Text="{Binding Display}" FontSize="12"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Border Classes="card" Padding="18">
                        <Grid>
                            <!-- 创建房间（三步引导） -->
                            <StackPanel x:Name="CreateTabContent" IsVisible="{Binding IsCreateTab}" Spacing="10">
                                <TextBlock Text="创建房间" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap">
                                    你不用单独开服务器，用游戏自带的局域网世界就能联机：
                                </TextBlock>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="sub" FontSize="12" TextWrapping="Wrap">第一步：先进入你要联机的世界。</TextBlock>
                                    <TextBlock Classes="sub" FontSize="12" TextWrapping="Wrap">第二步：在游戏里开启「局域网世界」。</TextBlock>
                                    <TextBlock Classes="sub" FontSize="12" TextWrapping="Wrap">第三步：回到启动器，点「创建房间」。</TextBlock>
                                </StackPanel>
                                <!-- EasyTier：游戏端口（朋友直接连接用） -->
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEasyTier}">
                                    <TextBlock Text="游戏端口" Classes="sub" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding GamePortText}" MaxLength="5" Width="90" FontSize="12"/>
                                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Text="游戏内「对局域网开放」显示的端口（默认 25565），用于朋友连接。"/>
                                </StackPanel>
                                <Button Content="创建房间" Classes="primary" HorizontalAlignment="Left" Padding="18,7"
                                        Command="{Binding CreateRoomCommand}"/>
                            </StackPanel>

                            <!-- 加入房间 -->
                            <StackPanel x:Name="JoinTabContent" IsVisible="{Binding IsJoinTab}" Spacing="10">
                                <TextBlock Text="加入房间" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="sub" FontSize="12" TextWrapping="Wrap">第一步：输入房主提供的房间代码。</TextBlock>
                                    <TextBlock Classes="sub" FontSize="12" TextWrapping="Wrap">第二步：点击「加入房间」，即可进入房间。</TextBlock>
                                </StackPanel>
                                <TextBox Text="{Binding JoinCode}" MaxLength="256" PlaceholderText="把房主给的房间代码填进来"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="粘贴" Classes="ghost" Padding="14,6" Command="{Binding PasteCodeCommand}"/>
                                    <Button Content="加入房间" Classes="primary" Padding="18,6" Command="{Binding JoinRoomCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 创建中 / 加入中（呼吸指示点 + 状态文字） -->
                <StackPanel x:Name="BusyBlock" IsVisible="{Binding IsBusy}" Spacing="10" Margin="0,40,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Border Classes.stagedot="True" Classes.current="True" Width="8" Height="8" CornerRadius="4"
                                Background="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BusyText}" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="420"
                               IsVisible="{Binding IsHost}"
                               Text="没检测到？你先进游戏开「局域网世界」。然后点菜单里的「对局域网开放」。"/>
                    <Button Content="取消" Classes="ghost" HorizontalAlignment="Center" Padding="20,6"
                            Command="{Binding CancelBusyCommand}"/>
                </StackPanel>

                <!-- 房间已就绪 -->
                <StackPanel x:Name="ActiveBlock" IsVisible="{Binding IsActive}" Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding HostName, StringFormat={}{0}的游戏房间}"
                                   FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                   Text="把房间码发给朋友，对方加入后你俩就在游戏里碰头。同一张地图，不用开服务器。"/>
                    </StackPanel>

                    <!-- 房间码高亮卡（项目约定加载器蓝） -->
                    <Border Classes="card" Padding="14,10" Background="{DynamicResource AccentDark}" BorderBrush="{DynamicResource AccentDark}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="房间代码" Classes="sub" FontSize="11"/>
                                <TextBlock Text="{Binding RoomCode}" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentLight}" FontFamily="Consolas"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="复制" Classes="primary" Padding="16,6"
                                    VerticalAlignment="Center" Command="{Binding CopyCodeCommand}"/>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="6">
                        <TextBlock Text="玩家列表" Classes="sub" FontSize="12"/>
                        <Border Classes="card" Padding="0">
                            <ItemsControl ItemsSource="{Binding Players}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MultiplayerPlayerVM">
                                        <Border Classes="row" Padding="12,8" BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource BorderColor}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White"
                                                               MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                    <Border CornerRadius="3" Padding="5,1" Background="{DynamicResource AccentDark}"
                                                            IsVisible="{Binding IsHost}" VerticalAlignment="Center">
                                                        <TextBlock Text="房主" FontSize="10" Foreground="{DynamicResource AccentLight}"/>
                                                    </Border>
                                                    <Border CornerRadius="3" Padding="5,1" Background="#2DD4BF"
                                                            IsVisible="{Binding IsLocal}" VerticalAlignment="Center">
                                                        <TextBlock Text="我" FontSize="10" Foreground="#0B1F1C"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding LatencyText}"
                                                           Classes="dim" FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- EasyTier：服务器地址（游戏内「直接连接」填这个） -->
                    <Border Classes="card" Padding="14,10" IsVisible="{Binding IsEasyTier}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="服务器地址（游戏里点「直接连接」填这个）" Classes="sub" FontSize="11"/>
                                <TextBlock Text="{Binding ServerAddress}" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentLight}" FontFamily="Consolas"/>
                                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                           Text="对方开着局域网世界后，你就能连上。连不上先检查网络与防火墙。"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="复制" Classes="primary" Padding="16,6"
                                    VerticalAlignment="Center" Command="{Binding CopyServerAddressCommand}"
                                    IsEnabled="{Binding ServerAddress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Grid>
                    </Border>

                    <Button Content="退出并解散" Classes="danger" HorizontalAlignment="Left" Padding="16,6"
                            IsVisible="{Binding IsHost}" Command="{Binding LeaveRoomCommand}"/>
                    <Button Content="离开房间" Classes="danger" HorizontalAlignment="Left" Padding="16,6"
                            IsVisible="{Binding !IsHost}" Command="{Binding LeaveRoomCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
