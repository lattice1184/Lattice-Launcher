<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Launcher.App.Views"
        x:Class="Launcher.App.Views.LogViewerWindow"
        x:DataType="vm:LogViewerWindow"
        Width="720" Height="520" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurface}">

    <DockPanel x:Name="Root" Margin="18,16">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="日志中心" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Classes="help-hint"
                        ToolTip.Tip="下载/启动/修复三类日志都在这里。选中条目右侧看内容；「打开文件」用记事本打开原文"><Path/></Border>
                <Button Content="刷新" Classes="ghost" FontSize="11" Padding="10,3"
                        HorizontalAlignment="Right" Margin="0,0,0,0" Click="OnRefresh"
                        ToolTip.Tip="重新扫描日志目录（新下载/启动会出现在对应分类）"/>
            </StackPanel>
        </StackPanel>

        <!-- 底部：打开文件 + 当前选中摘要 -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" x:Name="SummaryText" Classes="dim" FontSize="11" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" Content="打开文件" Classes="ghost" Padding="12,5"
                    IsEnabled="False" x:Name="OpenFileBtn" Click="OnOpenFile"
                    ToolTip.Tip="用系统记事本打开该日志原文"/>
        </Grid>

        <Grid ColumnDefinitions="260,*" ColumnSpacing="14">
            <!-- 左：树形分类 -->
            <Border Classes="surface" CornerRadius="{StaticResource RadiusSmall}" Padding="6">
                <TreeView x:Name="LogTree" ItemsSource="{Binding Categories}" SelectionMode="Single"
                          SelectionChanged="OnTreeSelectionChanged" PointerPressed="OnTreePointerPressed">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:LogNodeVM">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Icon}" FontSize="12"/>
                                <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CountText}" Classes="dim" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
            <!-- 右：内容 -->
            <Border Classes="surface" CornerRadius="{StaticResource RadiusSmall}" Padding="10">
                <ScrollViewer>
                    <TextBlock x:Name="ContentView" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               FontFamily="Consolas, Microsoft YaHei UI"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
