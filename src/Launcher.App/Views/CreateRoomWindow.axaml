<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Launcher.App.ViewModels"
        x:Class="Launcher.App.Views.CreateRoomWindow"
        Title="创建房间" Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgSurface}">

    <StackPanel Margin="24,20" Spacing="14">
        <TextBlock Text="创建局域网房间" FontSize="17" FontWeight="Bold"/>

        <StackPanel Spacing="8">
            <TextBlock Text="游戏版本" Classes="sub" FontSize="12"/>
            <ComboBox x:Name="VersionBox" PlaceholderText="选择已安装版本…">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VersionInstanceVM">
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="房间名" Classes="sub" FontSize="12"/>
            <TextBox x:Name="NameBox" PlaceholderText="留空自动用主机名"/>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="服务器端口" Classes="sub" FontSize="12"/>
            <TextBox x:Name="PortBox" Text="25565"/>
        </StackPanel>

        <TextBlock x:Name="HintText"
                   Text="创建房间会启动一个 Minecraft 服务端（此电脑作为主机）。首次创建会请求防火墙放行 UDP 34198，同意后才能被其他人发现。"
                   Classes="dim" FontSize="11" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="取消" Classes="ghost" Click="OnCancel"/>
            <Button Content="创建房间" Classes="primary" Click="OnCreate"/>
        </StackPanel>
    </StackPanel>
</Window>
