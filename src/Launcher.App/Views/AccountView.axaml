<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             x:Class="Launcher.App.Views.AccountView"
             x:DataType="vm:AccountViewModel">

    <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,16">
            <TextBlock Text="账号" FontSize="22" FontWeight="Bold"/>

            <!-- 当前账号卡片 -->
            <Border Classes="card" Padding="16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Image Source="{Binding Avatar}" Width="64" Height="64" Stretch="Uniform"/>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentName}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AccountType}" Classes="sub" FontSize="12" IsVisible="{Binding IsLoggedIn}"/>
                        <TextBlock Text="{Binding CurrentUuid}" Classes="dim" FontSize="11" IsVisible="{Binding IsLoggedIn}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 已保存账号列表（多账号切换） -->
            <Border Classes="card" Padding="16" IsVisible="{Binding Accounts.Count}">
                <StackPanel Spacing="8">
                    <TextBlock Text="已保存账号" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccountRowVM">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,3">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <Border CornerRadius="3" Padding="6,1" Background="#12332F"
                                                VerticalAlignment="Center" IsVisible="{Binding IsCurrent}">
                                            <TextBlock Text="当前" FontSize="10" Foreground="#B5F4E9"/>
                                        </Border>
                                        <TextBlock Text="{Binding TypeText}" Classes="dim" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="切换" Classes="ghost" FontSize="11" Padding="10,3"
                                            Command="{Binding $parent[UserControl].((vm:AccountViewModel)DataContext).SwitchAccountCommand}"
                                            CommandParameter="{Binding}" IsVisible="{Binding !IsCurrent}"/>
                                    <Button Grid.Column="2" Content="删除" Classes="danger" FontSize="11" Padding="10,3"
                                            Command="{Binding $parent[UserControl].((vm:AccountViewModel)DataContext).DeleteAccountCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 登录表单 -->
            <Border Classes="card" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="离线登录" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding NameInput}" Watermark="用户名"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="离线登录" Classes="primary" Command="{Binding LoginOfflineCommand}"/>
                        <Button Content="正版登录" Command="{Binding LoginMicrosoftCommand}"
                                IsEnabled="{Binding !IsMsAuthBusy}"/>
                        <Button Content="退出" Classes="ghost" Command="{Binding LogoutCommand}"
                                IsVisible="{Binding IsLoggedIn}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Classes="sub" FontSize="12"/>
                    <Border CornerRadius="6" Padding="10,8" Background="#12332F"
                            IsVisible="{Binding IsMsAuthBusy}">
                        <TextBlock Text="{Binding MsAuthStatus}" FontSize="12" Foreground="#B5F4E9"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
