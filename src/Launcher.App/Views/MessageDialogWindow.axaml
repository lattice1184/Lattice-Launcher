<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Launcher.App.Views.MessageDialogWindow"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgSurface}">

    <StackPanel x:Name="Root" Margin="26,22" Spacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14"
                   Foreground="{StaticResource TextPrimary}"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="取消" Classes="ghost" Click="OnCancel"/>
            <Button x:Name="ConfirmBtn" Content="确定" Classes="primary" Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</Window>
