<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Launcher.App.Views.MessageDialogWindow"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgSurface}">

    <StackPanel x:Name="Root" Margin="26,22" Spacing="16">
        <StackPanel Spacing="8">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14"
                       Foreground="{StaticResource TextPrimary}"/>
            <!-- 警告对话框的补充说明（普通色小字；Warn 用） -->
            <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource TextSecondary}" IsVisible="False"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="取消" Classes="ghost" Click="OnCancel"/>
            <Button x:Name="ConfirmBtn" Content="确定" Classes="primary" Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</Window>
